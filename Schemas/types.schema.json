{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invar:schema:2:types",
  "$defs": {
    "selector": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "pathPrefix": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "architecture": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "kind": {
          "enum": [
            "cycle",
            "forbiddenDependency"
          ]
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "from": {
          "$ref": "urn:invar:schema:2:types#/$defs/selector"
        },
        "to": {
          "$ref": "urn:invar:schema:2:types#/$defs/selector"
        },
        "approved": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "formal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+$"
        },
        "mode": {
          "enum": [
            "finite",
            "quantified"
          ]
        },
        "specification": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+$"
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "approved": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "acceptUnvalidatedModel": {
          "type": "boolean"
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 131072
        }
      },
      "required": [
        "id",
        "source",
        "mode",
        "specification",
        "toolchain"
      ],
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "sources"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "swift-modules-json/1"
          ]
        },
        "compiler": {
          "type": "string",
          "pattern": "^/"
        },
        "sdk": {
          "type": "string",
          "pattern": "^/"
        },
        "toolsDirectory": {
          "type": "string",
          "pattern": "^/"
        },
        "target": {
          "enum": [
            "arm64-apple-macosx27.0"
          ]
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "urn:invar:schema:2:types#/$defs/module"
          },
          "maxItems": 32
        },
        "harness": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "compiler",
        "sdk",
        "toolsDirectory",
        "modules",
        "harness"
      ],
      "additionalProperties": false
    },
    "native": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "profile": {
          "$ref": "urn:invar:schema:2:types#/$defs/profile"
        },
        "expectedTestCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "expectedSignal": {
          "enum": [
            4,
            5,
            6,
            8,
            10,
            11
          ]
        },
        "approved": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "profile"
      ],
      "additionalProperties": false
    },
    "fuzz": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "profile": {
          "$ref": "urn:invar:schema:2:types#/$defs/profile"
        },
        "corpus": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+$"
        },
        "inputEncoding": {
          "enum": [
            "signed64-decimal"
          ]
        },
        "seed": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "minimum": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "maximum": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "approved": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "acceptNoViolationObservedWithinBudget": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "profile",
        "corpus",
        "seed",
        "minimum",
        "maximum",
        "iterations"
      ],
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "architecture": {
          "type": "array",
          "items": {
            "$ref": "urn:invar:schema:2:types#/$defs/architecture"
          },
          "maxItems": 500
        },
        "formal": {
          "type": "array",
          "items": {
            "$ref": "urn:invar:schema:2:types#/$defs/formal"
          },
          "maxItems": 500
        },
        "native": {
          "type": "array",
          "items": {
            "$ref": "urn:invar:schema:2:types#/$defs/native"
          },
          "maxItems": 500
        },
        "fuzz": {
          "type": "array",
          "items": {
            "$ref": "urn:invar:schema:2:types#/$defs/fuzz"
          },
          "maxItems": 500
        }
      },
      "required": [
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sourceDigest": {
          "type": "string"
        },
        "startByte": {
          "type": "integer"
        },
        "endByte": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "language",
        "name"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "evidenceIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "producer",
        "scope",
        "evidenceIDs"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "freshness": {
          "type": "string"
        },
        "completeness": {
          "type": "string"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "producer",
        "scope",
        "freshness",
        "completeness",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5242880
        }
      },
      "required": [
        "path",
        "digest",
        "byteCount"
      ],
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "properties": {
        "workspaceID": {
          "type": "string"
        },
        "snapshotID": {
          "type": "string"
        },
        "contextDigest": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "urn:invar:schema:2:types#/$defs/entity"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "urn:invar:schema:2:types#/$defs/fact"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "urn:invar:schema:2:types#/$defs/coverage"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "urn:invar:schema:2:types#/$defs/input"
          }
        },
        "originalRecords": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "contentEncoding": "base64"
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "workspaceID",
        "snapshotID",
        "contextDigest",
        "metadata",
        "entities",
        "facts",
        "coverage",
        "inputs",
        "originalRecords",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maximumWorkers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 131072
        },
        "timeoutSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        },
        "runTimeoutSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        },
        "maximumOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "maximumProcesses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maximumCPUSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 86400
        },
        "maximumWorkspaceBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 10737418240
        }
      },
      "required": [
        "maximumWorkers",
        "memoryMiB",
        "timeoutSeconds",
        "runTimeoutSeconds",
        "maximumOutputBytes",
        "maximumProcesses",
        "maximumCPUSeconds",
        "maximumWorkspaceBytes"
      ],
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "backend": {
          "enum": [
            "static",
            "formal",
            "native",
            "fuzz",
            "modelGeneration",
            "project"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "approved": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "uniqueItems": true
        },
        "policy": {
          "$ref": "urn:invar:schema:2:types#/$defs/architecture"
        },
        "formal": {
          "$ref": "urn:invar:schema:2:types#/$defs/formal"
        },
        "native": {
          "$ref": "urn:invar:schema:2:types#/$defs/native"
        },
        "fuzz": {
          "$ref": "urn:invar:schema:2:types#/$defs/fuzz"
        },
        "toolchainIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "oracle": {
          "$ref": "#/$defs/input"
        },
        "compilation": {
          "$ref": "#/$defs/preparation"
        },
        "modelSource": {
          "$ref": "#/$defs/entity"
        },
        "project": {
          "$ref": "#/$defs/project"
        }
      },
      "required": [
        "id",
        "backend",
        "required",
        "approved",
        "dependencies",
        "memoryMiB",
        "inputs"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "body": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "executorIdentity": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "configurationDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "jobs": {
              "type": "array",
              "items": {
                "$ref": "urn:invar:schema:2:types#/$defs/job"
              },
              "minItems": 1,
              "maxItems": 500
            },
            "budget": {
              "$ref": "urn:invar:schema:2:types#/$defs/budget"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "input": {
              "$ref": "#/$defs/inputReference"
            }
          },
          "required": [
            "schemaVersion",
            "executorIdentity",
            "configurationDigest",
            "jobs",
            "budget",
            "diagnostics",
            "input"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "body"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "jobID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "execution": {
          "enum": [
            "completed",
            "cancelled",
            "timeout",
            "resourceLimited",
            "toolError",
            "unsupported",
            "blocked"
          ]
        },
        "outcome": {
          "enum": [
            "holdsWithinScope",
            "violatedWithinScope",
            "unknown",
            "notEvaluated",
            "noViolationObservedWithinBudget"
          ]
        },
        "domain": {
          "enum": [
            "architecture",
            "generatedModel",
            "nativeExecution",
            "projectContract"
          ]
        },
        "translation": {
          "enum": [
            "notApplicable",
            "unvalidated"
          ]
        },
        "scope": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "witnessFactIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "diagnosticCode": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "reproductionKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputID": {
          "type": "string"
        },
        "executionID": {
          "type": "string"
        },
        "descriptorID": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "executionKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adequacy": {
          "enum": [
            "completeWithinScope",
            "partial",
            "unknown"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      },
      "required": [
        "jobID",
        "execution",
        "outcome",
        "domain",
        "translation",
        "scope",
        "detail",
        "witnessFactIDs",
        "resources",
        "startedAt",
        "finishedAt",
        "id",
        "inputID",
        "adequacy",
        "assumptions",
        "artifacts"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "domain": {
              "const": "architecture"
            },
            "translation": {
              "const": "notApplicable"
            }
          }
        },
        {
          "properties": {
            "domain": {
              "const": "generatedModel"
            },
            "translation": {
              "const": "unvalidated"
            }
          }
        },
        {
          "properties": {
            "domain": {
              "const": "nativeExecution"
            },
            "translation": {
              "const": "notApplicable"
            }
          }
        },
        {
          "properties": {
            "domain": {
              "const": "projectContract"
            },
            "translation": {
              "const": "notApplicable"
            }
          }
        }
      ]
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "planID": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "urn:invar:schema:2:types#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 500
        },
        "accepted": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "associations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/association"
          }
        }
      },
      "required": [
        "id",
        "planID",
        "attempts",
        "accepted",
        "diagnostics",
        "associations"
      ],
      "additionalProperties": false
    },
    "replay": {
      "type": "object",
      "properties": {
        "originalRunID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "replayRunID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "jobs": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "reproduced",
              "unreproduced",
              "inconclusive"
            ]
          }
        }
      },
      "required": [
        "originalRunID",
        "replayRunID",
        "jobs"
      ],
      "additionalProperties": false
    },
    "inputReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "workspaceID": {
          "type": "string"
        },
        "snapshotID": {
          "type": "string"
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceIdentity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semanticDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "graphDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contextDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencyStatus": {
          "type": "string"
        },
        "graphClosureComplete": {
          "type": "boolean"
        },
        "entityCount": {
          "type": "integer",
          "minimum": 0
        },
        "factCount": {
          "type": "integer",
          "minimum": 0
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "workspaceID",
        "snapshotID",
        "manifestDigest",
        "sourceIdentity",
        "semanticDigest",
        "graphDigest",
        "contextDigest",
        "dependencyStatus",
        "graphClosureComplete",
        "entityCount",
        "factCount",
